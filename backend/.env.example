# Copy to .env and fill in. All backend settings are prefixed with MP_.

MP_ENVIRONMENT=development
MP_DEBUG=true

# Database — SQLite by default; use a postgresql+psycopg URL in production.
# MP_DATABASE_URL=sqlite:///./moneyprint.db
# MP_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/moneyprint

# Redis / Celery
MP_REDIS_URL=redis://localhost:6379/0

# Security — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_SECRET_ENCRYPTION_KEY=
# Optional local bearer token for the dashboard. Leave empty to disable auth.
MP_LOCAL_API_TOKEN=

# Media output directory (absolute or relative to the repo root).
# MP_MEDIA_ROOT=./media

# Reference learning (aprender o estilo de canais/vídeos de referência)
# Max uploads fetched per channel reference before stopping.
# MP_REFERENCE_MAX_VIDEOS=200
# How many representative videos get a full per-video analysis (Phase 4).
# MP_REFERENCE_DEEP_COUNT=5
# Unofficial YouTube caption scraping: off by default. Not an official API,
# can break at any time, and may violate YouTube's terms of service. Only
# enable this if you understand and accept that risk.
# MP_ENABLE_UNOFFICIAL_TRANSCRIPTS=false
# Keep reference transcripts after analysis instead of deleting them.
# MP_KEEP_TRANSCRIPTS=false
